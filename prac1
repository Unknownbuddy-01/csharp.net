7. Reverse number 
using System;

namespace practgical1
{
    class Program
    {
        static void Main(string[] args)
        {
            int num = 12345;
            int reverse = 0;
            int temp = num;

            while (temp != 0)
            {
                reverse = reverse * 10 + (temp % 10);
                temp /= 10;
            }

            Console.WriteLine("Reverse of " + num + " = " + reverse);
        }
    }
}

8. Check prime number 
 using System;

namespace practgical1
{
    class Program
    {
        static void Main(string[] args)
        {
            int num = 17;
            bool isPrime = true;

            if (num <= 1)
                isPrime = false;
            else
            {
                for (int i = 2; i <= Math.Sqrt(num); i++)
                {
                    if (num % i == 0)
                    {
                        isPrime = false;
                        break;
                    }
                }
            }

            if (isPrime)
                Console.WriteLine(num + " is Prime Number");
            else
                Console.WriteLine(num + " is Not Prime Number");
        }
    }
}

10. Simple calculator
using System;

namespace practgical1
{
    class Program
    {
        static void Main(string[] args)
        {
            int a = 20;
            int b = 10;
            char op = '+';

            switch (op)
            {
                case '+':
                    Console.WriteLine("Result = " + (a + b));
                    break;

                case '-':
                    Console.WriteLine("Result = " + (a - b));
                    break;

                case '*':
                    Console.WriteLine("Result = " + (a * b));
                    break;

                case '/':
                    if (b != 0)
                        Console.WriteLine("Result = " + (a / b));
                    else
                        Console.WriteLine("Cannot divide by zero");
                    break;

                default:
                    Console.WriteLine("Invalid Operator");
                    break;
            }
        }
    }
}


