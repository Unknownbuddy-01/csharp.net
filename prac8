8.3. Display Assembly Information
using System;
using System.Reflection;
namespace AssemblyDemo
{
class Program
{
static void Main(string[] args)
{
Assembly assembly = Assembly.GetExecutingAssembly();
Console.WriteLine("Assembly Name: " +
assembly.GetName().Name);
Console.WriteLine("Assembly Version: " +
assembly.GetName().Version);
Console.WriteLine("Assembly Location: " +
assembly.Location);
Console.ReadLine();
}
}
}
Sample Output
Assembly Name: AssemblyDemo
Assembly Version: 1.0.0.0
Assembly Location: C:\...\AssemblyDemo.exe

8.4. Using a NuGet Package
Step 1: Create Console Application
Create:
NuGetDemo
in Visual Studio 2019.
Step 2:
Install the package.
Tools → NuGet Package Manager → Package Manager Console
and execute:
Install-Package Newtonsoft.Json

Step 3: Program
using System;
using Newtonsoft.Json;
namespace NuGetDemo
{
class Student
{
public int Id { get; set; }
public string Name { get; set; }
public double Marks { get; set; }
}
class Program
{
static void Main(string[] args)
{
Student student = new Student
{
Id = 101,
Name = "Rahul",
Marks = 85.5
};
string json = JsonConvert.SerializeObject(student);
Console.WriteLine("JSON Data:");
Console.WriteLine(json);
Console.ReadLine();
}
}
}
Output
JSON Data:
{"Id":101,"Name":"Rahul","Marks":85.5}
Here:
using Newtonsoft.Json;
allows the program to use functionality provided by the NuGet package.

8.5. Student Marks Processing Using Parallel Programming
Marks of 10 students and want to calculate their grades in parallel.
using System;
using System.Threading.Tasks;
namespace StudentParallelDemo

{
class Program
{
static void Main(string[] args)
{
int[] marks = { 85, 72, 91, 65, 48, 78, 89, 55, 94, 69 };
Parallel.For(0, marks.Length, i =>
{
string grade;
if (marks[i] >= 80)
grade = "A";
else if (marks[i] >= 60)
grade = "B";
else if (marks[i] >= 40)
grade = "C";
else
grade = "F";
Console.WriteLine(
"Student " + (i + 1) +
" Marks: " + marks[i] +
" Grade: " + grade);
});
Console.ReadLine();
}
}
}
Sample Output
Student 1 Marks: 85 Grade: A
Student 2 Marks: 72 Grade: B
Student 3 Marks: 91 Grade: A
Student 4 Marks: 65 Grade: B
Student 5 Marks: 48 Grade: C
