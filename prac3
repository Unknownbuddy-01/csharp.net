Programs on Events
Practical 3. Write a program to create an event that displays a message when a button
click event occurs.
using System;
namespace EventDemo
{
class Button
{
public delegate void ClickHandler();
public event ClickHandler Click;
public void OnClick()
{
if (Click != null)
Click();
}
}
class Program
{
static void Display()
{
Console.WriteLine("Button Clicked!");
}
static void Main(string[] args)
{
Button b = new Button();
b.Click += Display;
b.OnClick();
Console.ReadLine();
}
}
}
