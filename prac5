5.9 LINQ GroupBy
using System;
using System.Linq;
class Student
{
public string Name { get; set; }
public string Department { get; set; }
}
class Program
{
static void Main()
{
Student[] students =
{
new Student{Name="Rahul",Department="IT"},
new Student{Name="Neha",Department="CS"},
new Student{Name="Amit",Department="IT"},
new Student{Name="Priya",Department="CS"}
};
var groups = students.GroupBy(x => x.Department);
foreach (var g in groups)
{
Console.WriteLine(g.Key);
foreach (var s in g)
{
Console.WriteLine(s.Name);
}
Console.WriteLine();
}
Console.ReadKey();
}
}
