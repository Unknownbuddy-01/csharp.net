using System.Linq;
namespace LINQDemo
{
class Program
{
static void Main(string[] args)
{
int[] numbers = { 12, 45, 20, 5, 80, 32 };
var result = from n in numbers
where n > 20
select n;
Console.WriteLine("Numbers Greater Than 20");
foreach (int n in result)
{
