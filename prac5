5.12 LINQ Join
using System;
using System.Linq;
class Student
{
public int Id;
public string Name;
}
class Result
{
public int Id;
public int Marks;
}
class Program
{
static void Main()
{
Student[] students =
{
new Student{Id=1,Name="Rahul"},
new Student{Id=2,Name="Neha"},

new Student{Id=3,Name="Amit"}
};
Result[] results =
{
new Result{Id=1,Marks=85},
new Result{Id=2,Marks=90},
new Result{Id=3,Marks=80}
};
var query = from s in students
join r in results
on s.Id equals r.Id
select new
{
s.Name,
r.Marks
};
foreach (var item in query)
{
Console.WriteLine(item.Name + " " + item.Marks);
}
Console.ReadKey();
}
}
