Program 6: Display All Files in a Directory
Aim
Display all files present in a specified directory.
Program

using System;
using System.IO;
namespace FilesStreamsDemo
{
class Program
{
static void Main(string[] args)
{
string folder = "StudentData";
if (Directory.Exists(folder))
{
string[] files = Directory.GetFiles(folder);
Console.WriteLine("Files in directory:");
foreach (string file in files)
{
Console.WriteLine(file);
}
}
else
{
Console.WriteLine("Directory does not exist.");
}
Console.ReadKey();
}
}
}
Explanation
Directory.GetFiles() returns the names of files present in the specified directory.
