Program 4: Copy, Move and Delete a File
Aim
Perform basic file-system operations.
Program
using System;
using System.IO;
namespace FilesStreamsDemo
{
class Program
{
static void Main(string[] args)
{
string original = "student.txt";
string copy = "student_backup.txt";
string moved = "student_new.txt";
// Create original file
File.WriteAllText(original, "Student information");
// Copy file
File.Copy(original, copy, true);
Console.WriteLine("File copied.");
// Move file
File.Move(copy, moved);
Console.WriteLine("File moved.");
// Delete moved file
File.Delete(moved);
Console.WriteLine("File deleted.");
Console.ReadKey();
}
}
}
Output
File copied.
File moved.

File deleted.
