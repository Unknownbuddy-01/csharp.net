Program 1: Create and Write to a File
Aim : Create a text file and write student information into it.
Program
using System;
using System.IO;
namespace FilesStreamsDemo
{
class Program
{
static void Main(string[] args)
{
string fileName = "student.txt";
File.WriteAllText(fileName,
"Name: Rahul\nCourse: BSc IT\nRoll No: 101");
Console.WriteLine("Data written successfully.");
