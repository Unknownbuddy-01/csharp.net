Program 8: Read Data Using StreamReader
Aim
Read a text file line by line using StreamReader.
Program
using System;
using System.IO;
namespace FilesStreamsDemo
{
class Program
{
static void Main(string[] args)
{
using (StreamReader reader =
new StreamReader("students.txt"))
{
string line;

while ((line = reader.ReadLine()) != null)
{
Console.WriteLine(line);
}
}
Console.ReadKey();
}
}
}
Explanation
ReadLine() reads one line at a time. The loop continues until the end of the file is reached.
Program 9: Copy a File Using FileStream
Aim
Copy the contents of one file to another using FileStream.
Program
using System;
using System.IO;
namespace FilesStreamsDemo
{
class Program
{
static void Main(string[] args)
{
string source = "students.txt";
string destination = "students_copy.txt";
using (FileStream input =
new FileStream(source, FileMode.Open))
using (FileStream output =
new FileStream(destination, FileMode.Create))
{
input.CopyTo(output);
}
Console.WriteLine("File copied using FileStream.");
Console.ReadKey();
}
}
}
Program 10: Write and Read Bytes Using FileStream

Aim
Write data as bytes and read it using FileStream.
Program
using System;
using System.IO;
using System.Text;
namespace FilesStreamsDemo
{
class Program
{
static void Main(string[] args)
{
string fileName = "data.txt";
string text = "Hello from FileStream!";
byte[] data = Encoding.UTF8.GetBytes(text);
// Writing
using (FileStream stream =
new FileStream(fileName, FileMode.Create))
{
stream.Write(data, 0, data.Length);
}
// Reading
using (FileStream stream =
new FileStream(fileName, FileMode.Open))
{
byte[] readData = new byte[stream.Length];
stream.Read(readData, 0, readData.Length);
string result =
Encoding.UTF8.GetString(readData);
Console.WriteLine(result);
}
Console.ReadKey();
}
}
}
Output
Hello from FileStream!
